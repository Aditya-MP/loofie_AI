DATABASE_URL=postgresql+psycopg://loofie:loofie_dev@localhost:5433/loofie_ai
TEST_DATABASE_URL=postgresql+psycopg://loofie:loofie_dev@localhost:5433/loofie_ai_test

# Models run on the GPU. Set to cpu only on a machine without an NVIDIA GPU.
DEVICE=cuda
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384

# Shared secret the backend sends as the X-API-Key header. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_API_KEY=
# On a server use named keys, one per caller (rotate by listing old and new under the same name):
# AI_API_KEYS=backend:KEY1,ops:KEY2
AI_API_KEYS=

# Instagram connect (Meta developer app). Blank = off. Default login: Unified Login (log in with
# Instagram, no Facebook Page). docs/OPERATIONS.md "Instagram Login" has the setup.
IG_APP_ID=
IG_APP_SECRET=
# Public https URL of this service's callback; register the same URL in the Meta app.
IG_REDIRECT_URI=https://ai.example.com/auth/instagram/callback
# Encrypts stored Instagram tokens. Generate once: uv run loofie instagram new-key
# Never change it afterwards (stored tokens become unreadable), never commit it.
IG_TOKEN_KEY=
# unified | facebook | instagram. Blank = config/instagram.toml (unified).
IG_FLAVOR=
# Facebook Login for Business configuration id. Required for unified; optional for facebook.
IG_FB_CONFIG_ID=
# Sync worker threads inside the API (0 = none; then run `loofie instagram worker`).
IG_WORKERS=2
# Creator app page the browser returns to after login.
APP_RETURN_URL=https://app.example.com/creator/instagram

# Pilot on this PC (scripts/pilot.ps1): name of a Cloudflare named tunnel. Blank = quick tunnel
# with a random URL on every start. Setup: docs/OPERATIONS.md, "Pilot server".
PILOT_TUNNEL=
